# Local development only. Do not put production secrets in this file.
APP__ENV=development
APP__HOST=127.0.0.1
APP__PORT=8000
APP__LOG_LEVEL=INFO
APP__LOG_FORMAT=json
APP__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
APP__REQUEST_ID_HEADER=X-Request-ID

SECURITY__ENABLED=true
SECURITY__API_KEY=replace-with-a-local-development-secret
SECURITY__API_KEYS={}

LLM__PROVIDER=mock
LLM__MODEL=mock-model
LLM__API_KEY=
LLM__BASE_URL=

RATE_LIMIT__ENABLED=false
RATE_LIMIT__BACKEND=memory
RATE_LIMIT__REQUESTS=60
RATE_LIMIT__WINDOW_SECONDS=60
RATE_LIMIT__REDIS_URL=redis://localhost:6379/0

EMBEDDING__PROVIDER=dummy
EMBEDDING__MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING__DIMENSION=384
EMBEDDING__DEVICE=cpu
EMBEDDING__NORMALIZE=true
EMBEDDING__API_KEY=
EMBEDDING__BASE_URL=

VECTOR_STORE__BACKEND=in_memory
VECTOR_STORE__COLLECTION=documents
VECTOR_STORE__URL=http://localhost:6333
VECTOR_STORE__HOST=localhost
VECTOR_STORE__PORT=6333
VECTOR_STORE__PERSIST_PATH=./data/vector_store
VECTOR_STORE__VECTOR_SIZE=
VECTOR_STORE__DISTANCE=cosine

RETRIEVAL__TOP_K_DENSE=10
RETRIEVAL__TOP_K_SPARSE=10
RETRIEVAL__RERANK_TOP_K=4
RETRIEVAL__SCORE_THRESHOLD=0.65
RETRIEVAL__FUSION_STRATEGY=rrf
RETRIEVAL__RRF_K=60
RETRIEVAL__DENSE_WEIGHT=0.7
RETRIEVAL__SPARSE_WEIGHT=0.3
RETRIEVAL__CHUNK_SIZE=600
RETRIEVAL__CHUNK_OVERLAP=100

BM25__PERSIST_PATH=./data/bm25_index.jsonl
BM25__REBUILD_ON_BOOT=true

RERANKER__PROVIDER=none
RERANKER__TOP_K=4

INGEST__QUEUE_PATH=./data/ingest_queue.db
INGEST__WORKER_TIMEOUT_SECONDS=300
INGEST__MAX_ATTEMPTS=3
INGEST__DEDUP_STRATEGY=hash
# Set to false for shadow/read-only hosts that serve a pre-seeded corpus.
INGEST__WORKER_ENABLED=true

UPLOAD__MAX_SIZE_BYTES=15728640
UPLOAD__DIRECTORY=./data/uploads

DATABASE__PATH=./data/app.db
