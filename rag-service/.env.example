# Local development only. Do not put production secrets in this file.
APP__ENV=development
APP__HOST=127.0.0.1
APP__PORT=8000
APP__LOG_LEVEL=INFO
APP__LOG_FORMAT=json
APP__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
APP__REQUEST_ID_HEADER=X-Request-ID
APP__REQUEST_TIMEOUT_SECONDS=120
APP__MAX_CONCURRENT_REQUESTS=8

SECURITY__ENABLED=true
SECURITY__API_KEY=replace-with-a-local-development-secret
SECURITY__API_KEYS={}
# Bật true khi mọi request đến từ Spring đã mang principal và workspace scope.
SECURITY__REQUIRE_PRINCIPAL=false
SECURITY__PRINCIPAL_HEADER=X-User-Id
SECURITY__PRINCIPAL_WORKSPACES_HEADER=X-User-Workspaces

LLM__PROVIDER=mock
LLM__MODEL=mock-model
LLM__API_KEY=
LLM__BASE_URL=
LLM__RETRY_BACKOFF_MS=500

# Spring resolver cho provider theo project/user. Tắt nếu chạy RAG độc lập.
PROVIDER_CONFIG__ENABLED=true
PROVIDER_CONFIG__BASE_URL=http://localhost:8080
PROVIDER_CONFIG__INTERNAL_TOKEN=local-development-rag-internal-token-32
PROVIDER_CONFIG__CACHE_TTL_SECONDS=60
PROVIDER_CONFIG__TIMEOUT_SECONDS=5
PROVIDER_CONFIG__FAILURE_COOLDOWN_SECONDS=30

RATE_LIMIT__ENABLED=false
RATE_LIMIT__BACKEND=memory
RATE_LIMIT__REQUESTS=60
RATE_LIMIT__WINDOW_SECONDS=60
RATE_LIMIT__REDIS_URL=redis://localhost:6379/0

EMBEDDING__PROVIDER=dummy
EMBEDDING__MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING__DIMENSION=384
EMBEDDING__DEVICE=cpu
EMBEDDING__NORMALIZE=true
EMBEDDING__API_KEY=
EMBEDDING__BASE_URL=
EMBEDDING__CACHE_ENABLED=true
EMBEDDING__CACHE_PATH=./data/embedding_cache.sqlite3

VECTOR_STORE__BACKEND=in_memory
VECTOR_STORE__COLLECTION=documents
VECTOR_STORE__URL=http://localhost:6333
VECTOR_STORE__API_KEY=
VECTOR_STORE__PERSIST_PATH=./data/vector_store
VECTOR_STORE__VECTOR_SIZE=
VECTOR_STORE__DISTANCE=cosine
VECTOR_STORE__TIMEOUT_SECONDS=30

RETRIEVAL__TOP_K_DENSE=10
RETRIEVAL__TOP_K_SPARSE=10
RETRIEVAL__RERANK_TOP_K=4
RETRIEVAL__SCORE_THRESHOLD=0.65
RETRIEVAL__FUSION_STRATEGY=weighted
RETRIEVAL__RRF_K=60
RETRIEVAL__DENSE_WEIGHT=0.7
RETRIEVAL__SPARSE_WEIGHT=0.3
RETRIEVAL__CHUNK_SIZE=600
RETRIEVAL__CHUNK_UNIT=tokens
RETRIEVAL__CHUNK_SIZE_TOKENS=512
RETRIEVAL__CHUNK_OVERLAP_TOKENS=64
RETRIEVAL__MIN_CHUNK_TOKENS=24
RETRIEVAL__INDEX_VERSION=chunk-v3
RETRIEVAL__CHUNK_OVERLAP=100

BM25__PERSIST_PATH=./data/bm25_index.jsonl
BM25__REBUILD_ON_BOOT=true
BM25__STRIP_DIACRITICS=false
BM25__EXPAND_COMPOUNDS=true

RERANKER__PROVIDER=none
RERANKER__MODEL=BAAI/bge-reranker-v2-m3
RERANKER__API_KEY=
RERANKER__TOP_N=30
RERANKER__TIMEOUT_SECONDS=20
RERANKER__FALLBACK_PROVIDER=simple

INGEST__WORKER_TIMEOUT_SECONDS=300
INGEST__MAX_ATTEMPTS=3
INGEST__DEDUP_STRATEGY=hash
# Set to false for shadow/read-only hosts that serve a pre-seeded corpus.
INGEST__WORKER_ENABLED=true

UPLOAD__MAX_SIZE_BYTES=15728640
UPLOAD__DIRECTORY=./data/uploads


GRAPH__MAX_REWRITE_RETRIES=2
GRAPH__CONTEXT_MAX_CHARS=12000
GRAPH__TRUNCATION_STRATEGY=tail
GRAPH__SKIP_REWRITE_MAX_WORDS=8
GRAPH__REWRITE_CACHE_TTL_SECONDS=600
GRAPH__GRADE_BATCH=false
GRAPH__GRADE_BATCH_SIZE=5
