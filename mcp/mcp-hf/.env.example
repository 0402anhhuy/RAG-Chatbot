# Hugging Face token with "Make calls to Inference Providers" permission.
# Optional: without it the server still lists public models/providers.
HF_TOKEN=

# Account quota lookup via whoami-v2 (needs HF_TOKEN).
HF_MCP_ENABLE_ACCOUNT_QUOTA=true

# Reserved for a future opt-in model smoke-test tool.
HF_MCP_ENABLE_CHAT=false

HF_MCP_TRANSPORT=stdio
HF_MCP_HOST=127.0.0.1
HF_MCP_PORT=8765
HF_MCP_TIMEOUT_SECONDS=15
HF_MCP_CACHE_TTL_SECONDS=300
